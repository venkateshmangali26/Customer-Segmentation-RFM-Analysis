// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  country   String   @default("Unknown")
  channel   String   @default("Web")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]
  rfm          RfmSnapshot?
}

model Transaction {
  id          String   @id @default(cuid())
  customerId  String
  orderId     String
  amount      Float
  currency    String   @default("USD")
  productCategory String?
  occurredAt  DateTime
  createdAt    DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([occurredAt])
}

// Stores the latest computed RFM snapshot per customer.
model RfmSnapshot {
  id             String   @id @default(cuid())
  customerId     String   @unique
  recencyDays    Int      // days since last purchase (lower = better)
  frequency      Int      // count of distinct orders
  monetary       Float    // total spend
  recencyScore   Int      // 1..5
  frequencyScore Int      // 1..5
  monetaryScore  Int      // 1..5
  rfmScore       String   // e.g. "554"
  segment        String   // e.g. "Champions"
  updatedAt      DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([segment])
}
